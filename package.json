{
  "name": "sentinel-wildfire",
  "version": "1.0.0",
  "description": "Real-time wildfire tracking intelligence platform",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:routing": "node cloud/ors-routing/dev.mjs",
    "dev:all": "bash dev.sh",
    "build": "vite build",
    "preview": "vite preview",
    "prerender": "node scripts/prerender.mjs",
    "data:county-population": "node --env-file-if-exists=.env scripts/build-county-population.mjs",
    "ipaws-server": "node server/ipaws-server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "npx playwright test",
    "lint": "eslint ."
  },
  "dependencies": {
    "@mapbox/mapbox-gl-draw": "^1.5.1",
    "@supabase/supabase-js": "^2.103.0",
    "@turf/bbox": "^7.4.0",
    "@turf/bbox-clip": "^7.4.0",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/buffer": "^7.4.0",
    "@turf/simplify": "^7.4.0",
    "date-fns": "^3.6.0",
    "fast-xml-parser": "^5.7.2",
    "lucide-react": "^0.344.0",
    "mapbox-gl": "^3.21.0",
    "nexrad-level-2-data": "^3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-map-gl": "^7.1.9",
    "react-router-dom": "^7.18.2"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.19",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.23",
    "serve": "^14.2.6",
    "supabase": "^2.92.1",
    "tailwindcss": "^3.4.7",
    "vite": "^8.0.16",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6",
    "compression": "^1.8.2"
  }
}
