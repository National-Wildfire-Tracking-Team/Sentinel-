{
  "name": "sentinel-wildfire",
  "version": "1.0.0",
  "description": "Real-time wildfire tracking intelligence platform",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:all": "bash dev.sh",
    "build": "vite build",
    "preview": "vite preview",
    "prerender": "node scripts/prerender.mjs",
    "ipaws-server": "node server/ipaws-server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "npx playwright test",
    "lint": "eslint .",
    "cap:sync": "vite build && npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@mapbox/mapbox-gl-draw": "^1.5.1",
    "@supabase/supabase-js": "^2.103.0",
    "date-fns": "^3.6.0",
    "fast-xml-parser": "^5.7.2",
    "lucide-react": "^0.344.0",
    "mapbox-gl": "^3.21.0",
    "nexrad-level-2-data": "^3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-map-gl": "^7.1.9",
    "react-router-dom": "^7.14.0"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.4.19",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.40",
    "serve": "^14.2.6",
    "supabase": "^2.92.1",
    "tailwindcss": "^3.4.7",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
