# ─────────────────────────────────────────────────────────────────────────────
# Sentinel – Frontend Configuration
# Copy this file to .env and fill in your credentials.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase – Reporter submission system backend
# Create a free project at: https://supabase.com/
# Copy the URL + anon key from Project Settings → API
# Then run supabase/schema.sql in the Supabase SQL editor.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Mapbox (Optional – only for satellite base-map tiles)
# Free token at: https://account.mapbox.com/
# Restrict this token by URL in the Mapbox dashboard.
# Leave empty to use the default free MapLibre + Carto dark tiles instead.
# NOTE: Geocoding calls go through the Supabase edge function – no token needed here for that.
VITE_MAPBOX_TOKEN=

# GOES satellite tile endpoints (optional)
# Defaults use Iowa Environmental Mesonet WMS. Set these only if you run your own
# NOAA GOES tile service (for example, a GOES-DL-backed pipeline).
# Each value must be a raster URL template compatible with mapbox-gl:
#  - XYZ template: https://example.com/tiles/{z}/{x}/{y}.png
#  - WMS template: ...&BBOX={bbox-epsg-3857}
# VITE_GOES_EAST_VISIBLE_TILE_URL=
# VITE_GOES_WEST_VISIBLE_TILE_URL=
# VITE_GOES_EAST_FIRE_RGB_TILE_URL=
# VITE_GOES_WEST_FIRE_RGB_TILE_URL=
# Optional attribution overrides when using custom tile sources:
# VITE_GOES_EAST_ATTRIBUTION=
# VITE_GOES_WEST_ATTRIBUTION=
# VITE_GOES_EAST_FIRE_ATTRIBUTION=
# VITE_GOES_WEST_FIRE_ATTRIBUTION=

# App settings
# How often to refresh live data (milliseconds). Default: 5 minutes
VITE_REFRESH_INTERVAL=300000

# IPAWS OPEN EAS JSON (optional). In local dev, defaults to `/alerts` when unset (Vite proxies to `npm run ipaws-server`).
# In production, set to your deployed poller URL, e.g. https://api.example.com/alerts
# VITE_IPAWS_ALERTS_URL=

# ── Secrets stored in Supabase (NOT in this file) ──────────────────────────────
# Sensitive API keys are stored as Supabase project secrets and consumed only
# inside the server-side edge functions in supabase/functions/.
# Run the following commands once after creating your Supabase project:
#
#   supabase secrets set NASA_FIRMS_API_KEY=<your_key>
#   supabase secrets set AIRNOW_API_KEY=<your_key>
#   supabase secrets set MAPBOX_TOKEN=<your_token>
#
# Get keys at:
#   NASA FIRMS : https://firms.modaps.eosdis.nasa.gov/api/
#   AirNow     : https://docs.airnowapi.org/login
#   Mapbox     : https://account.mapbox.com/

# ── Supabase secrets (incident-updates-sync / notification-sync Edge Functions) ─
# scripts/incident-updates-sync.mjs and scripts/notification-sync.mjs have been
# migrated to supabase/functions/incident-updates-sync and
# supabase/functions/notification-sync, scheduled via pg_cron (see
# supabase/migrations/20260915000000_scheduled_sync_infrastructure.sql)
# instead of GitHub Actions. SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are
# injected automatically into every Edge Function by Supabase — only these
# need to be set explicitly, once, via:
#
#   supabase secrets set RESEND_API_KEY=<value>       # https://resend.com/api-keys
#   supabase secrets set RESEND_FROM_EMAIL=<value>    # optional — defaults to "Sentinel Wildfire Alerts <onboarding@resend.dev>"
#   supabase secrets set APP_URL=<value>              # optional — defaults to https://app.nationalwildfiretrackingteam.org
#
# Also required once, run directly in the Supabase SQL editor (never commit
# these values — see the migration file's comment for why):
#
#   select vault.create_secret('https://<your-project-ref>.supabase.co', 'project_url');
#   select vault.create_secret('<service_role key>', 'service_role_key');
#
# NEXRAD and MRMS radar sync both run on Google Cloud Run Jobs, not GitHub
# Actions (Edge Functions can't handle either: NEXRAD's decode exceeds
# memory limits, MRMS needs a native wgrib2 binary Deno can't run at all —
# see those migration/function file comments) — see cloud/nexrad-sync/README.md
# and cloud/mrms-sync/README.md for the full deploy runbooks. Their
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY values live in Google Secret
# Manager, not GitHub Actions secrets.
#
# REPORTER_URL defaults to https://reporter.nationalwildfiretrackingteam.org

# ── NEXRAD radar (Google Cloud: Firestore + Cloud Storage) ─────────────────────
# The NEXRAD radar pipeline — both compute (cloud/nexrad-sync, a Cloud Run
# Job; cloud/nexrad-heartbeat, a Cloud Run service) and data (Firestore +
# Cloud Storage, replacing Postgres + Supabase Storage) — has moved off
# Supabase entirely, as the first piece of the project's broader move to
# Google Cloud. MRMS Composite Radar has been removed outright (Composite
# Radar is now built from every NEXRAD site's own sweep instead — see
# src/app/hooks/useNexradComposite.js).
#
# Firebase config below is all public (same publicity level as the Supabase
# URL/anon key above) — access control lives in Firestore Security Rules
# (firestore.rules) and Firebase Anonymous Auth, not in keeping these values
# private. Get them from the Firebase console → Project settings → General
# → "Your apps" → SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_APP_ID=

# The deployed URL of the cloud/nexrad-heartbeat Cloud Run service (see
# `gcloud run services describe nexrad-heartbeat --format 'value(status.url)'`).
# Used both for the heartbeat POST and for GET <this>/scan/<path> — the
# client never talks to the scan bucket directly (it's not public — the
# org's iam.allowedPolicyMemberDomains policy blocks that — so
# cloud/nexrad-heartbeat proxies reads using its own credentials instead).
# The bucket name itself (NEXRAD_SCANS_BUCKET) is a server-side-only env var
# on cloud/nexrad-sync and cloud/nexrad-heartbeat, not something the client
# needs to know.
VITE_NEXRAD_HEARTBEAT_URL=https://nexrad-heartbeat-xxxxxxxxxx.a.run.app

# The deployed URL of the cloud/fema-nfhl-proxy Cloud Run service, which
# serves the FEMA National Flood Hazard Layer (Flood Hazard map layer). The
# browser only ever talks to this service, never to FEMA directly; until it's
# set the layer reports "not configured". See cloud/fema-nfhl-proxy/README.md.
VITE_FEMA_NFHL_PROXY_URL=https://fema-nfhl-proxy-xxxxxxxxxx.a.run.app

# Deployed URLs of the cloud/california-land-ownership-proxy and
# cloud/calfire-frap-proxy Cloud Run services. Optional: when unset, the Land
# Ownership layer and the CAL FIRE FRAP perimeter fallback fetch their
# upstream sources directly instead. See each service's README.
# VITE_CALIFORNIA_LAND_OWNERSHIP_PROXY_URL=https://california-land-ownership-proxy-xxxxxxxxxx.a.run.app
# VITE_CALFIRE_FRAP_PROXY_URL=https://calfire-frap-proxy-xxxxxxxxxx.a.run.app

# See cloud/nexrad-sync/README.md and cloud/nexrad-heartbeat/README.md for
# the full deploy runbooks (Firestore rules/indexes, IAM, Cloud Scheduler).

# NIFC / WFIGS perimeters – No key required (public ArcGIS endpoint)
# CAL FIRE (fire.ca.gov) – No key; browser CORS is bypassed via `/api/calfire` (see netlify.toml, vercel.json, vite) or Supabase `calfire-proxy` if you deploy that function.
# NOAA Weather Alerts – No key required (public US government API)
# US Drought Monitor – No key required (public endpoint)
