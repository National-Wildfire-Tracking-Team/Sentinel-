{
  "expo": {
    "name": "Sentinel",
    "slug": "sentinel-mobile",
    "platforms": [
      "ios",
      "android"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/sentinel-app-icon.png",
    "scheme": "sentinel",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0c0e",
    "ios": {
      "bundleIdentifier": "org.nationalwildfiretrackingteam.sentinel",
      "appleTeamId": "5QLC79W89G",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "org.nationalwildfiretrackingteam.sentinel",
      "adaptiveIcon": {
        "backgroundColor": "#0a0c0e",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "@rnmapbox/maps",
      [
        "expo-notifications",
        {
          "color": "#ff5a00"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sentinel uses your location to show wildfires near you."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0c0e",
          "image": "./assets/images/sentinel-app-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "699a0a23-aede-4ca9-a0bb-b00a05031eab"
      }
    },
    "owner": "nwtt"
  }
}
