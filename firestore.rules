// Firestore security rules for the NEXRAD radar pipeline (the first piece
// of the app's move off Supabase — see the migration plan for scope).
//
// Mirrors the Postgres RLS policies this replaces:
// - nexradScanMeta / nexradScanHistory: public read, matching those tables'
//   `for select using (true)` policies. No client writes at all — both
//   collections are written exclusively by cloud/nexrad-sync (the Cloud Run
//   Job) and cloud/nexrad-heartbeat (the priming service) via the Admin
//   SDK, which bypasses these rules entirely, the same way the old
//   Postgres tables had no insert/update/delete policies at all (only the
//   service-role key, used server-side, could write).
// - nexradActiveSites / edgeRateLimits: no client access whatsoever,
//   matching nexrad_active_sites' original "zero policies" design —
//   internal bookkeeping only, read and written exclusively server-side.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /nexradScanMeta/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /nexradScanHistory/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /nexradActiveSites/{docId} {
      allow read, write: if false;
    }

    match /edgeRateLimits/{docId} {
      allow read, write: if false;
    }
  }
}
