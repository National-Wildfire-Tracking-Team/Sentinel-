{
  "rewrites": [
    {
      "source": "/api/calfire",
      "destination": "https://incidents.fire.ca.gov/umbraco/api/IncidentApi/GeoJsonList"
    },
    {
      "source": "/api/nhc/current",
      "destination": "https://www.nhc.noaa.gov/CurrentStorms.json"
    },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
